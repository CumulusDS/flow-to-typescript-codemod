{
  "name": "flow-to-typescript-codemod",
  "version": "0.0.0",
  "private": true,
  "description": "Stripe's codemod for converting Flow to TypeScript.",
  "repository": "https://github.com/stripe-archive/flow-to-typescript-codemod",
  "license": "MIT",
  "author": "Stripe, Inc.",
  "types": "./flow.d.ts",
  "bin": {
    "typescriptify": "./bin.js"
  },
  "files": [
    "dist",
    "flow.d.ts",
    "bin.js"
  ],
  "scripts": {
    "build": "./esBuild.js",
    "dev": "yarn build && node ./dist/index.js",
    "typescriptify": "yarn build && node ./dist/index.js",
    "cumulusify": "yarn ts-node ./cumulusStepsRunner.ts",
    "lint": "eslint --ext ts src",
    "prepare": "yarn patch-package",
    "prettier": "prettier --write 'src/**/*.{js,jsx,mdx,ts,tsx}' !src/test/test_files/*.{js,jsx,ts,tsx}",
    "test": "jest",
    "types": "tsc -b ."
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "7.29.7",
    "@types/dedent": "^0.7.2",
    "@types/fs-extra": "^8.1.5",
    "@types/jest": "^30.0.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.1.1",
    "@types/react": "^16.14.70",
    "@types/signale": "^1.4.7",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "chalk": "^4.1.2",
    "csv-stringify": "^6.8.1",
    "dedent": "^0.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-prettier": "^5.5.6",
    "flow": "^0.2.3",
    "flow-bin": "^0.272.2",
    "fs-extra": "^8.1.0",
    "ignore": "^5.3.2",
    "jest": "^30.4.2",
    "jest-junit": "^12.3.0",
    "patch-package": "^6.5.1",
    "prettier": "^3.9.5",
    "recast": "^0.23.12",
    "signale": "^1.4.0",
    "ts-jest": "^29.4.11",
    "ts-morph": "^13.0.3",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "yargs": "^17.7.3"
  },
  "packageManager": "yarn@4.17.1"
}
